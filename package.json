{
  "name": "gogol-crosshairs",
  "version": "1.4.0",
  "description": "Application de crosshair personnalisable",
  "main": "main.js",
  "author": "LoloLeDev",
  "keywords": [
    "crosshair",
    "gaming",
    "overlay"
  ],
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.gogolcrosshairs.app",
    "productName": "GogolCrosshairs",
    "files": [
      "main.js",
      "storage.js",
      "index.html",
      "renderer.js",
      "styles.css",
      "overlay.js",
      "overlay.html",
      "logo.png",
      "dist/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "logo.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "Lololegeek",
      "repo": "gogolcrosshairs"
    }
  }
}
